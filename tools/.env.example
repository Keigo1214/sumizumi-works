# tools/.env.example
#
# これをコピーして tools/.env を作り、実値を入れる:
#   PowerShell: Copy-Item tools\.env.example tools\.env
#   Git Bash  : cp tools/.env.example tools/.env
#
# tools/.env は絶対にGitにコミットしない（tools/.gitignore で除外済み）。
# 実値はこのファイル（.env.example）には書かないこと。

# --------------------------------------------------------------------------
# Search Console
# --------------------------------------------------------------------------
# ドメインプロパティの場合:      sc-domain:example.com
# URLプレフィックスの場合:       https://example.com/    ← 末尾スラッシュ必須
GSC_SITE_URL=

# --------------------------------------------------------------------------
# GA4
# --------------------------------------------------------------------------
# GA4管理画面 → 管理 → プロパティ設定 に出る「プロパティID」（数字のみ）
# 測定ID（G-XXXXXXX）ではないので注意
GA4_PROPERTY_ID=

# --------------------------------------------------------------------------
# Google OAuth（デスクトップアプリ方式。通常はこちらを使う）
# --------------------------------------------------------------------------
# Google Cloud Console でダウンロードした client_secret_*.json の絶対パス。
# このJSONファイル自体もGit管理外に置くこと（例: C:\Users\<user>\.config\affiliate\）
GOOGLE_OAUTH_CLIENT_SECRETS=

# 発行済みトークンの保存先。未設定なら tools/.gsc_token.json が使われる。
GOOGLE_OAUTH_TOKEN=

# --------------------------------------------------------------------------
# サービスアカウントを使う場合のみ（無人サーバー運用向け・任意）
# 設定するとOAuthより優先される。GA4・Search Consoleの両方に
# サービスアカウントのメールアドレスを閲覧者として追加すること。
# --------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=

# --------------------------------------------------------------------------
# 通知（任意）
# --------------------------------------------------------------------------
# Slack / Discord などの Incoming Webhook URL。price_diff.py --notify で使う。
PRICE_DIFF_WEBHOOK_URL=
